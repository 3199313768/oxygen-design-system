{
  "name": "@oxygen-design/patterns",
  "version": "0.2.0",
  "description": "Oxygen 通用页面组合：AppShell、EmptyState、PageHeader 和 StatusMessage。不包含具体业务的数据访问、路由或状态管理。",
  "keywords": [
    "react",
    "design-system",
    "patterns",
    "typescript"
  ],
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/3199313768/oxygen-design-system.git",
    "directory": "packages/patterns"
  },
  "homepage": "https://github.com/3199313768/oxygen-design-system/tree/main/packages/patterns#readme",
  "bugs": {
    "url": "https://github.com/3199313768/oxygen-design-system/issues"
  },
  "type": "module",
  "files": [
    "dist",
    "styles.css.d.ts"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": {
      "types": "./styles.css.d.ts",
      "default": "./dist/styles.css"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@oxygen-design/ui": ">=0.2.0 <1.0.0",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@oxygen-design/ui": "workspace:*"
  },
  "scripts": {
    "build": "vite build && node ../../scripts/finalize-package-dist.mjs",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.json",
    "test:coverage": "vitest run --coverage"
  }
}
