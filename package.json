{
  "name": "oxygen-design-system",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "build": "pnpm --filter @oxygen-design/ui build && pnpm --filter @oxygen-design/patterns build",
    "storybook": "pnpm build && pnpm --filter @oxygen-design/storybook storybook",
    "storybook:build-only": "pnpm --filter @oxygen-design/storybook build-storybook",
    "storybook:build": "pnpm build && pnpm storybook:build-only",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck && pnpm exec tsc --project tests/docs/tsconfig.json && pnpm exec tsc --project tests/foundation/tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "test:coverage": "pnpm -r --if-present test:coverage",
    "verify": "pnpm typecheck && pnpm lint && pnpm docs:check && pnpm test:tooling && pnpm test:surface && pnpm test:coverage && pnpm build && pnpm storybook:build-only",
    "verify:package": "node scripts/verify-package.mjs && node scripts/verify-patterns-package.mjs",
    "verify:workbench": "node scripts/verify-workbench.mjs",
    "workbench": "node scripts/verify-workbench.mjs --preview",
    "verify:release": "node scripts/verify-initial-release.mjs",
    "verify:initial-release": "pnpm verify:release",
    "release": "pnpm build && pnpm changeset pack --out-dir output/release && node scripts/publish-npm.mjs output/release/publish-plan.json && pnpm changeset git-tag",
    "test:surface": "node scripts/quality-gate.mjs coverage",
    "test:tooling": "node --test tests/tooling/*.test.mjs",
    "verify:protection": "node scripts/verify-merge-gate.mjs",
    "docs:generate": "node scripts/docs-api.mjs && node scripts/docs-stories.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "docs:preview": "node scripts/serve-storybook.mjs",
    "verify:docs": "pnpm docs:check && pnpm exec playwright test --config playwright.docs.config.ts",
    "verify:foundation": "pnpm exec tsc --project tests/foundation/tsconfig.json && pnpm exec playwright test --config playwright.foundation.config.ts"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.61.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "axe-core": "4.14.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5"
  }
}
